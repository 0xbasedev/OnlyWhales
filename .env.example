# ---- Public: baked into the browser bundle -------------------------------------------------
# 56 = BNB Smart Chain, 97 = BSC testnet, 31337 = local anvil
VITE_CHAIN_ID=56
# Leave empty before launch. The site then runs in look-don't-touch mode.
VITE_VAULT_ADDRESS=
# Optional: your own RPC endpoint and WalletConnect project id
VITE_RPC_URL=
VITE_WC_PROJECT_ID=

# ---- Server only: never prefix these with VITE_ ---------------------------------------------
# The Telegram bot (preferred). With all four set, /api/access returns a one-time link to the bot,
# which ties each Telegram account to one wallet, approves join requests itself and removes wallets
# that close their position. See "The Telegram bot" in README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# The group's id: a negative number such as -1001234567890
TELEGRAM_CHAT_ID=
# 32+ random characters (A-Z a-z 0-9 _ -). Signs start codes, authenticates the webhook and encrypts
# the members file. Changing it makes the members file unreadable. Generate: openssl rand -hex 32
TELEGRAM_SECRET=
# Without Blob, the encrypted members file is kept here (needs a persistent disk)
TELEGRAM_MEMBERS_FILE=data/telegram-members.json

# Without the bot: one shared invite link, returned by /api/access after signature + on-chain checks.
TELEGRAM_INVITE_LINK=
# RPC used by the API for on-chain checks (falls back to VITE_RPC_URL, then a public endpoint)
RPC_URL=
# Branding storage. On Vercel, connect a Blob store and this is set for you.
BLOB_READ_WRITE_TOKEN=
# Otherwise branding is saved to this file (needs a persistent disk)
BRANDING_FILE=data/branding.json
